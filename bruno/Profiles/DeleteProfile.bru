meta {
  name: DeleteProfile (soft)
  type: http
  seq: 6
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:graphql {
  mutation DeleteProfile($id: UUID!) {
    deleteProfile(id: $id) {
      id
      deletedAt
    }
  }
}

body:graphql:vars {
  {
    "id": "{{profile_id}}"
  }
}
