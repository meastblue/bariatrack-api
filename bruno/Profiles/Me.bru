meta {
  name: Me
  type: http
  seq: 2
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:graphql {
  query Me {
    me {
      id
      email
      role
      locale
      createdAt
      updatedAt
    }
  }
}

body:graphql:vars {
  {}
}
