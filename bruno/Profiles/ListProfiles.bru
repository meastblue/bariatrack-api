meta {
  name: ListProfiles (admin)
  type: http
  seq: 4
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:graphql {
  query ListProfiles($includeDeleted: Boolean) {
    listProfiles(includeDeleted: $includeDeleted) {
      id
      authUserId
      email
      role
      locale
      createdAt
      updatedAt
      deletedAt
    }
  }
}

body:graphql:vars {
  {
    "includeDeleted": false
  }
}
