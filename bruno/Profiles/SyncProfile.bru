meta {
  name: SyncProfile
  type: http
  seq: 1
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:graphql {
  mutation SyncProfile {
    syncProfile(data: { role: PATIENT }) {
      id
      email
      role
      locale
      createdAt
    }
  }
}

body:graphql:vars {
  {}
}
