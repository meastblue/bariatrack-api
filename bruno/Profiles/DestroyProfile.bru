meta {
  name: DestroyProfile (hard - RGPD)
  type: http
  seq: 7
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:graphql {
  mutation DestroyProfile($id: UUID!) {
    destroyProfile(id: $id)
  }
}

body:graphql:vars {
  {
    "id": "{{profile_id}}"
  }
}
