meta {
  name: GetProfile
  type: http
  seq: 5
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:graphql {
  query GetProfile($id: UUID!) {
    getProfile(id: $id) {
      id
      authUserId
      email
      role
      locale
      createdAt
      updatedAt
      deletedAt
    }
  }
}

body:graphql:vars {
  {
    "id": "{{profile_id}}"
  }
}
