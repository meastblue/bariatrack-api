meta {
  name: UpdatePatient
  type: http
  seq: 3
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:graphql {
  mutation UpdatePatient($id: UUID!, $data: UpdatePatientInput!) {
    updatePatient(id: $id, data: $data) {
      id
      targetWeightKg
      notes
      updatedAt
    }
  }
}

body:graphql:vars {
  {
    "id": "{{patient_id}}",
    "data": {
      "targetWeightKg": 72.0,
      "notes": "Objectif révisé après consultation"
    }
  }
}
