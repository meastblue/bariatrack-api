meta {
  name: MyPatient
  type: http
  seq: 2
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:graphql {
  query MyPatient {
    myPatient {
      id
      profileId
      surgeryType
      surgeryDate
      initialWeightKg
      targetWeightKg
      heightCm
      gender
      bloodType
      primaryDoctorId
      allergies
      notes
      createdAt
      updatedAt
    }
  }
}

body:graphql:vars {
  {}
}
