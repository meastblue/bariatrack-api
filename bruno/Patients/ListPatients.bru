meta {
  name: ListPatients (admin)
  type: http
  seq: 4
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:graphql {
  query ListPatients {
    patients {
      id
      profileId
      surgeryType
      surgeryDate
      initialWeightKg
      heightCm
      createdAt
    }
  }
}

body:graphql:vars {
  {}
}
