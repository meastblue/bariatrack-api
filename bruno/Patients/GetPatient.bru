meta {
  name: GetPatient
  type: http
  seq: 5
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:graphql {
  query GetPatient($id: UUID!) {
    patient(id: $id) {
      id
      profileId
      surgeryType
      surgeryDate
      initialWeightKg
      targetWeightKg
      heightCm
      dateOfBirth
      gender
      bloodType
      primaryDoctorId
      allergies
      notes
      createdAt
      updatedAt
    }
  }
}

body:graphql:vars {
  {
    "id": "{{patient_id}}"
  }
}
