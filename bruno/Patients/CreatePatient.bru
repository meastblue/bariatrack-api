meta {
  name: CreatePatient
  type: http
  seq: 1
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:graphql {
  mutation CreatePatient($data: CreatePatientInput!) {
    createPatient(data: $data) {
      id
      profileId
      surgeryType
      surgeryDate
      initialWeightKg
      targetWeightKg
      heightCm
      gender
      bloodType
      createdAt
    }
  }
}

body:graphql:vars {
  {
    "data": {
      "surgeryType": "SLEEVE_GASTRECTOMY",
      "surgeryDate": "2025-06-15",
      "initialWeightKg": 120.5,
      "heightCm": 175.0,
      "targetWeightKg": 75.0,
      "gender": "MALE",
      "bloodType": "O_POS"
    }
  }
}
