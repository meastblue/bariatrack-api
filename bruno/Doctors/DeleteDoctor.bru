meta {
  name: DeleteDoctor
  type: http
  seq: 8
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:graphql {
  mutation DeleteDoctor($id: UUID!) {
    deleteDoctor(id: $id)
  }
}

body:graphql:vars {
  {
    "id": "{{doctor_id}}"
  }
}
