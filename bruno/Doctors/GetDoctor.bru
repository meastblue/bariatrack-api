meta {
  name: GetDoctor
  type: http
  seq: 7
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:graphql {
  query GetDoctor($id: UUID!) {
    doctor(id: $id) {
      id
      profileId
      specialty
      licenseNumber
      hospitalName
      phoneProfessional
      timezone
      isVerified
      createdAt
      updatedAt
    }
  }
}

body:graphql:vars {
  {
    "id": "{{doctor_id}}"
  }
}
