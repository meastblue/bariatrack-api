meta {
  name: ListDoctors (admin)
  type: http
  seq: 6
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:graphql {
  query ListDoctors {
    doctors {
      id
      profileId
      specialty
      licenseNumber
      hospitalName
      phoneProfessional
      timezone
      isVerified
      createdAt
      updatedAt
    }
  }
}

body:graphql:vars {
  {}
}
