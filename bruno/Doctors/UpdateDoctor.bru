meta {
  name: UpdateDoctor
  type: http
  seq: 5
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:graphql {
  mutation UpdateDoctor($id: UUID!, $data: UpdateDoctorInput!) {
    updateDoctor(id: $id, data: $data) {
      id
      hospitalName
      phoneProfessional
      updatedAt
    }
  }
}

body:graphql:vars {
  {
    "id": "{{doctor_id}}",
    "data": {
      "hospitalName": "Clinique Saint-Michel",
      "phoneProfessional": "+33698765432"
    }
  }
}
