meta {
  name: VerifiedDoctors
  type: http
  seq: 3
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:graphql {
  query VerifiedDoctors {
    verifiedDoctors {
      id
      specialty
      hospitalName
      timezone
    }
  }
}

body:graphql:vars {
  {}
}
