meta {
  name: MyDoctor
  type: http
  seq: 2
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:graphql {
  query MyDoctor {
    myDoctor {
      id
      profileId
      specialty
      licenseNumber
      hospitalName
      phoneProfessional
      timezone
      isVerified
      createdAt
      updatedAt
    }
  }
}

body:graphql:vars {
  {}
}
