meta {
  name: CreateDoctor
  type: http
  seq: 1
}

post {
  url: {{base_url}}/graphql
  body: graphql
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:graphql {
  mutation CreateDoctor($data: CreateDoctorInput!) {
    createDoctor(data: $data) {
      id
      profileId
      specialty
      licenseNumber
      hospitalName
      phoneProfessional
      timezone
      isVerified
      createdAt
    }
  }
}

body:graphql:vars {
  {
    "data": {
      "specialty": "chirurgie_bariatrique",
      "licenseNumber": "10012345678",
      "hospitalName": "Hôpital Lariboisière",
      "phoneProfessional": "+33612345678",
      "timezone": "Europe/Paris"
    }
  }
}
